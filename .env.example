# Identifiants Singpay (obligatoires pour les routes /api/singpay/*)
SINGPAY_CLIENT_ID=your_singpay_client_id
SINGPAY_CLIENT_SECRET=your_singpay_client_secret
SINGPAY_WALLET_ID=your_singpay_wallet_id

# URL Singpay v1. Laisser cette valeur en environnement de test si necessaire.
SINGPAY_GATEWAY_URL=https://gateway.singpay.ga/v1

# En mode test, le montant est remplace par 100 par /api/singpay/initiate.
# Valeurs attendues : test ou production (toute autre valeur est consideree comme production).
MODE=production

# Variables conservees pour les integrations de decaissement futures ou legacy.
SINGPAY_DISBURSEMENT_AIRTEL=your_airtel_disbursement_id
SINGPAY_DISBURSEMENT_MOOV=your_moov_disbursement_id